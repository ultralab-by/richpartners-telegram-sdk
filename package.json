{
  "name": "richpartners-telegram-sdk",
  "version": "1.0.25",
  "description": "richPartners ads telegram",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:ts": "tsc",
    "build:vite": "vite build",
    "build": "npm run clean && npm run build:ts && npm run build:vite",
    "prepublishOnly": "npm run clean && npm run build",
    "postbuild": "cp -r src/assets dist/assets"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ultralab-by/richpartners-telegram-sdk"
  },
  "keywords": [
    "telegram",
    "ads",
    "richpartners",
    "push-style",
    "embedded",
    "interstitial"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@telegram-apps/sdk": "^3.0.0",
    "crypto-js": "^4.2.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "open": "^10.1.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  },
  "files": [
    "dist",
    "src/assets/richpartners-style.css",
    "src/img/tg-background.webp"
  ]
}
